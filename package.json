{
    "name": "chord-grabber",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "dev": "vite --host",
        "build": "tsc --noEmit && tsc -p tsconfig.engine.json && vite build",
        "preview": "vite preview --host",
        "test": "node --test \"src/**/*.test.ts\"",
        "format": "prettier --write .",
        "corpus": "node scripts/corpus.ts data/chordonomicon_v2.csv",
        "evaluate": "node scripts/evaluate.ts",
        "tune": "node scripts/tune.ts"
    },
    "devDependencies": {
        "@spotify/basic-pitch": "^1.0.1",
        "@tombatossals/chords-db": "0.5.1",
        "@types/node": "^26.6.6",
        "linkedom": "^0.18.15",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    }
}
